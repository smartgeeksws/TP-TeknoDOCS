[mysql]
host = "TU_HOST_MYSQL"
port = 3306
database = "TU_BASE_DE_DATOS"
user = "TU_USUARIO_MYSQL"
password = "TU_CONTRASEÑA_MYSQL"

[openai]
api_key = "TU_API_KEY_OPENAI"
model = "gpt-5-mini"

[storage]
type = "ftps"
host = "host.josekrea.com"
port = 21
username = "TU_USUARIO_FTPS"
password = "TU_CONTRASEÑA_FTPS"
# La raíz de esta cuenta debe estar fuera de public_html.
remote_dir = "/firmas"
